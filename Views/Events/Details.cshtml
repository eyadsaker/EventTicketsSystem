@model EventDetailsVM

<div class="container mt-4">
    <h2>@Model.Event.Title</h2>
    <p class="text-muted">@Model.Event.Description</p>
    <hr />

    <h3>Available Ticket Types</h3>

    @foreach (var ticket in Model.TicketTypes)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@ticket.Name</h5>
                <p class="card-text">Price: @ticket.Price EGP</p>
                <p class="card-text">Available: @ticket.AvailableQuantity</p>

                @if (ticket.AvailableQuantity > 0)
                {
                    <form asp-controller="Bookings" asp-action="Create" method="post">
                        <input type="hidden" name="TicketTypeId" value="@ticket.Id" />
                        <div class="mb-3">
                            <label>Quantity:</label>
                            <input type="number" name="Quantity" value="1" min="1" max="@ticket.AvailableQuantity" class="form-control w-25" />
                        </div>
                        <button type="submit" class="btn btn-success">Book Now</button>
                    </form>
                }
                else
                {
                    <span class="text-danger">Sold Out</span>
                }
            </div>
        </div>
    }
</div>